# Google Gemini API Key (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenSubtitles API (free: https://www.opensubtitles.com/consumers)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# HandBrake preset name (run: HandBrakeCLI --preset-list)
HANDBRAKE_PRESET=Fast 1080p30

# Directories
SOURCE_DIR=./input
OUTPUT_DIR=./output
